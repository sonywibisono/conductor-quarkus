# --- Build Stage ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@11.1.0 --activate

WORKDIR /app

# Copy dependency manifests and pnpm config to leverage Docker layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* .npmrc* ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy the rest of the application files
COPY . .

# Ensure runtime context configuration file exists
RUN if [ ! -f public/context.js ]; then cp public/context.js.example public/context.js; fi

# Accept build arguments for environment configuration
ARG VITE_WF_SERVER
ARG VITE_USE_BFF=true
ARG VITE_BFF_GATEWAY_URL=/api

ENV VITE_WF_SERVER=$VITE_WF_SERVER
ENV VITE_USE_BFF=$VITE_USE_BFF
ENV VITE_BFF_GATEWAY_URL=$VITE_BFF_GATEWAY_URL
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Build standalone production app
RUN pnpm run build

# --- Production Stage ---
FROM nginx:stable-alpine AS runner

# Copy custom Nginx configuration for SPA routing & reverse proxying
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
